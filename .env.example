# Base de données PostgreSQL
POSTGRES_USER=tabac_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=scraper-tabac

# URLs de connexion
DATABASE_URL=postgresql://tabac_user:your_password@db:5432/scraper-tabac
TEST_DATABASE_URL=postgresql://tabac_user:your_password@db:5432/scraper-tabac-test

# pgAdmin
PGADMIN_EMAIL=your@email.com
PGADMIN_PASSWORD=your_pgadmin_password

# Auth
JWT_SECRET=change_this_secret_in_production

# Resend (service d'envoi d'emails — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=no-reply@yourdomain.com

# URL du frontend (utilisée dans les liens des emails)
FRONTEND_URL=http://localhost:3000
